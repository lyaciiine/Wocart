              <path d="M0 -14L3.5 -3.5L14 0L3.5 3.5L0 14L-3.5 3.5L-14 0L-3.5 -3.5Z" transform="translate(660 330) scale(0.55)" fill="#F1E3B2" filter="url(#lp-glow)" class="lp-twinkle"/>
