      <!-- السعر + CTA -->
      <div class="md:col-start-1 text-center md:text-start">
        <div data-reveal="260" class="bg-white/5 border border-[#D4AF37]/25 rounded-2xl p-5 max-w-md mx-auto md:mx-0 backdrop-blur-sm">
          <p class="text-[11px] text-[#9FB4A6] font-medium">سعر العرض</p>
          <div class="flex items-end justify-center md:justify-start gap-3 mt-1 flex-wrap">
            <bdi dir="ltr" class="lp-font-head font-black text-4xl text-[#F1E3B2] whitespace-nowrap">{fmtPrice(basePrice)} {cur}</bdi>
            {comparePrice !== null && cmp > bp && (
              <bdi dir="ltr" class="text-[#8FA79A] line-through text-lg mb-1 whitespace-nowrap">{fmtPrice(comparePrice)} {cur}</bdi>
            )}
