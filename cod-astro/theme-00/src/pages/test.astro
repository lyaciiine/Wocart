<!-- سكريبت الواجهة (معرض، كشف عند السكرول، شريط ثابت، تنقّل) — مستقل تماماً عن سكريبتات المتجر -->
<script>
(() => {
  const d = document;
  const root = d.getElementById("lp-root");
  if (!root) return;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const isRTL = (root.getAttribute("dir") || "ltr") === "rtl";

  /* الهيدر: خلفية صلبة بعد السكرول */
  const head = d.getElementById("lp-head");
  const onScroll = () => { if (head) head.classList.toggle("lp-head-solid", window.scrollY > 12); };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  /* الكشف التدريجي عند السكرول */
  const revealEls = Array.from(root.querySelectorAll("[data-reveal]"));
  if (!reduce && "IntersectionObserver" in window && revealEls.length) {
    revealEls.forEach((el) => {
      el.classList.add("lp-rv");
      const delay = parseInt(el.getAttribute("data-reveal") || "0", 10);
      if (delay) el.style.transitionDelay = delay + "ms";
    });
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting) { en.target.classList.add("lp-rv-in"); io.unobserve(en.target); }
      });
    }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
    revealEls.forEach((el) => io.observe(el));
  }

  /* أزرار الطلب: سكرول سلس + ومضة على الفورمولار */
  const orderWrap = d.getElementById("order-section-wrapper");
  const orderCard = d.getElementById("lp-order-card");
  let flashTimer = 0;
  root.querySelectorAll("a[data-cta]").forEach((a) => {
    a.addEventListener("click", (ev) => {
      if (!orderWrap) return;
      ev.preventDefault();
      orderWrap.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
      if (orderCard) {
        orderCard.classList.remove("lp-flash");
        void orderCard.offsetWidth;
        orderCard.classList.add("lp-flash");
        clearTimeout(flashTimer);
        flashTimer = window.setTimeout(() => orderCard.classList.remove("lp-flash"), 1800);
      }
      if (history.replaceState) history.replaceState(null, "", "#order-section-wrapper");
    });
  });

  /* المعرض: أسهم، نقاط، مصغّرات، سحب باللمس، تشغيل تلقائي */
  const gal = d.getElementById("lp-gallery");
  if (gal) {
    const slides = Array.from(gal.querySelectorAll(".lp-slide"));
    const dots = Array.from(root.querySelectorAll(".lp-dot"));
    const thumbs = Array.from(root.querySelectorAll(".lp-thumb"));
    const counter = d.getElementById("lp-gal-count");
    const n = slides.length;
    let idx = 0, stopped = false, hovering = false;
    const paint = () => {
      slides.forEach((s, k) => { s.style.opacity = k === idx ? "1" : "0"; });
      dots.forEach((dt, k) => {
        dt.classList.toggle("w-6", k === idx);
        dt.classList.toggle("bg-[#D4AF37]", k === idx);
        dt.classList.toggle("bg-white/40", k !== idx);
        dt.setAttribute("aria-current", k === idx ? "true" : "false");
      });
      thumbs.forEach((th, k) => {
        th.classList.toggle("ring-[#D4AF37]", k === idx);
        th.classList.toggle("ring-transparent", k !== idx);
        th.classList.toggle("opacity-70", k !== idx);
      });
      if (counter) counter.textContent = (idx + 1) + " / " + n;
    };
    const go = (i, manual) => {
      if (!n) return;
      idx = ((i % n) + n) % n;
      if (manual) stopped = true;
      paint();
    };
    if (n > 1) {
      gal.querySelectorAll("[data-gal-prev]").forEach((b) => b.addEventListener("click", () => go(idx - 1, true)));
      gal.querySelectorAll("[data-gal-next]").forEach((b) => b.addEventListener("click", () => go(idx + 1, true)));
      dots.forEach((dt, k) => dt.addEventListener("click", () => go(k, true)));
      thumbs.forEach((th, k) => th.addEventListener("click", () => go(k, true)));
      gal.addEventListener("keydown", (ev) => {
        if (ev.key === "ArrowRight") { ev.preventDefault(); go(idx + (isRTL ? -1 : 1), true); }
        if (ev.key === "ArrowLeft") { ev.preventDefault(); go(idx + (isRTL ? 1 : -1), true); }
      });
      let sx = 0, sy = 0, tracking = false;
      gal.addEventListener("pointerdown", (ev) => { tracking = true; sx = ev.clientX; sy = ev.clientY; }, { passive: true });
      gal.addEventListener("pointerup", (ev) => {
        if (!tracking) return;
        tracking = false;
        const dx = ev.clientX - sx, dy = ev.clientY - sy;
        if (Math.abs(dx) > 42 && Math.abs(dx) > Math.abs(dy) * 1.4) go(idx + (dx < 0 ? 1 : -1), true);
      }, { passive: true });
      gal.addEventListener("pointercancel", () => { tracking = false; }, { passive: true });
      gal.addEventListener("mouseenter", () => { hovering = true; });
      gal.addEventListener("mouseleave", () => { hovering = false; });
      if (!reduce) {
        window.setInterval(() => { if (!stopped && !hovering && !d.hidden) go(idx + 1, false); }, 5000);
      }
      paint();
    }
  }

  /* تمييز القسم الحالي في القائمة */
  const spyLinks = Array.from(root.querySelectorAll("a[data-spy]"));
  if ("IntersectionObserver" in window && spyLinks.length) {
    const map = new Map();
    spyLinks.forEach((a) => {
      const id = (a.getAttribute("href") || "").slice(1);
      const sec = id && d.getElementById(id);
      if (sec) map.set(sec, a);
    });
    const spy = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        const link = map.get(en.target);
        if (!link || !en.isIntersecting) return;
        spyLinks.forEach((l) => l.classList.remove("lp-spy-on"));
        link.classList.add("lp-spy-on");
      });
    }, { rootMargin: "-35% 0px -55% 0px" });
    map.forEach((_a, sec) => spy.observe(sec));
  }

  /* شريط الطلب الثابت: يظهر بعد الهيرو ويختفي عند الفورمولار */
  const bar = d.getElementById("lp-bar");
  const hero = d.getElementById("lp-hero");
  if (bar && hero && orderWrap && "IntersectionObserver" in window) {
    let heroVis = true, orderVis = false;
    const upd = () => bar.classList.toggle("lp-bar-show", !heroVis && !orderVis);
    new IntersectionObserver((es) => { es.forEach((e) => { heroVis = e.isIntersecting; }); upd(); }, { threshold: 0.04 }).observe(hero);
    new IntersectionObserver((es) => { es.forEach((e) => { orderVis = e.isIntersecting; }); upd(); }, { threshold: 0.12 }).observe(orderWrap);
  }

  /* الأسئلة: فتح واحد في كل مرة */
  const faqs = Array.from(root.querySelectorAll("details.lp-faq"));
  faqs.forEach((fq) => fq.addEventListener("toggle", () => {
    if (fq.open) faqs.forEach((o) => { if (o !== fq) o.open = false; });
  }));
})();
</script>
</div>
)}

