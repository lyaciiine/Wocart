---
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import OrderForm from "@/theme/components/order/OrderForm.astro";
import ShippingIsland from "@/theme/components/product/ShippingIsland.astro";
import { getStoreContext } from "@/theme/config/store";
import { fetchLandingPageBySlug } from "@/core/api/client";
import { actions } from "astro:actions";
import { isInputError } from "astro:actions";
const storeCtx = await getStoreContext();
const { config, content, isRTL } = storeCtx;
// استدعاء صفحة الهبوط بالـ Slug الصحيح (مثلاً: lacoste أو اسم صفحة الهبوط اللي راك دايرها في الداشبورد)
const lp = await fetchLandingPageBySlug("lacoste");
const product = lp?.product;
const cur = config.currencySymbol;
const defaultVariant = product?.hasVariants
? (product.variants.find((v: any) => v.isDefault) ?? product.variants[0])
: null;
const basePrice = defaultVariant?.price ?? product?.price ?? 0;
const comparePrice = defaultVariant?.compareAtPrice ?? product?.compareAtPrice ?? null;
const isOutOfStock = product?.trackInventory && product.inventory === 0;
const defaultVariantId = defaultVariant?.id ?? null;
// معالجة إرسال الطلبية
const result = Astro.getActionResult(actions.placeOrder);
if (result?.data?.orderNumber) {
return Astro.redirect(
`/thank-you?order=${encodeURIComponent(result.data.orderNumber)}&total=${result.data.total}&oid=${encodeURIComponent(result.data.orderId ?? "")}`,
303,
);
}
const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const serverError = result?.error && !isInputError(result.error) ? result.error.message : null;

/* ─────────────────────────────────────────────────────────────
   ✨ إضافات عرضية فقط (Presentational) — ما تمسّ حتى متغير موجود
   ───────────────────────────────────────────────────────────── */

// 🖼️ الصور: نقراو product.images أولاً، وإذا ما كانش نروحو لـ lp.images.
// نقبلو: نص مباشر ("https://...") أو كائن فيه url / src / image.
// 👉 إذا ما بانوش التصاور عندك: بدّل السطر تاع rawImages لتحت باش يطابق
//    الحقل الحقيقي في البيانات تاعك (مثلاً: product?.media ?? lp?.gallery).
const rawImages: any = product?.images ?? lp?.images ?? [];
const gallery: string[] = (typeof rawImages === "string" ? [rawImages] : Array.isArray(rawImages) ? rawImages : [])
  .map((img: any) => (typeof img === "string" ? img : (img?.url ?? img?.src ?? img?.image ?? null)))
  .filter((src: any) => typeof src === "string" && src.trim().length > 0);
const hasGallery = gallery.length > 0;

const fmtPrice = (n: any) => Number(n ?? 0).toLocaleString("fr-FR");
const bp = Number(basePrice ?? 0);
const cmp = Number(comparePrice ?? 0);
const discountPct = cmp > bp && bp > 0 ? Math.round(((cmp - bp) / cmp) * 100) : null;
const inv = Number(product?.inventory ?? 0);
const lowStock = product?.trackInventory && inv > 0 && inv <= 10 ? inv : null;
const ratingVal = 4.8;
const ratingCount = 132;
const year = new Date().getFullYear();

const tickerItems = [
  "الدفع عند الاستلام",
  "توصيل لـ 69 ولاية",
  "خامة مضادة للحساسية",
  "تصميم لاكوست الأصيل",
  "قفل ديبليان آمن",
  "المحيط 19 سم — قابل للتقصير",
];

const features = [
  { icon: "hlink", num: "01", title: "مايين H الأيقونية", text: "الـ DNA ديال لاكوست يبان في كل مايون: تصميم H متناسق يعطي للسوار شخصية قوية وأناقة ما تخطاهاش العين." },
  { icon: "pique", num: "02", title: "نقش Petit Piqué", text: "المايين الوسطانية جايين بنقش البيتيت بيكيه الشهير — نفس النسيج تاع بولو لاكوست الأسطوري، مترجم للمعدن." },
  { icon: "clasp", num: "03", title: "فيرموار ديبليان", text: "قفل يتطوى بأمان ويندمج مع التصميم بلا ما يبان. تحلو وتسدو بيد وحدة، وتلبس السوار في ثواني." },
  { icon: "shield", num: "04", title: "مضاد للحساسية", text: "خامة Hypoallergénique تحافظ على بشرتك: بلا احمرار وبلا حساسية، تلبسو نهار كامل بكل راحة." },
];

const specs = [
  { k: "الاسم", v: "Bracelet Metropole", ltr: true },
  { k: "المجموعة", v: "Lacoste — L'ADN emblématique", ltr: true },
  { k: "المحيط الداخلي", v: "19 سم" },
  { k: "القفل", v: "ديبليان (Fermoir déployant)" },
  { k: "النقش", v: "Petit Piqué على المايين الوسطانية" },
  { k: "الخامة", v: "مضادة للحساسية (Hypoallergénique)" },
  { k: "التعديل", v: "قابل للتقصير عند الساعة / الجواهرجي" },
  { k: "التوصيل", v: "69 ولاية — الدفع عند الاستلام" },
];

const reviews = [
  { n: "أمين ب.", c: "الجزائر العاصمة", r: 5, t: "الجودة فاقت التوقعات. المايين H يبانو أنقى من التصاور، ولبستو مع المونتر — الإطلالة ولات كاملة." },
  { n: "سارة م.", c: "وهران", r: 5, t: "كان خايفة يجي واسع على يدي، الجواهرجي قصّرو لي في دقائق. خدمة نقية وتصميم راقي بزاف." },
  { n: "يوسف ك.", c: "قسنطينة", r: 4, t: "وصلني في يومين وخلصت عند الاستلام كيما مكتوب. القفل الديبليان ساهل وعملي، ننصح بيه." },
];

const faqs = [
  { q: "كيفاش ندير الطلبية؟", a: "عمّر الفورمولار لتحت — الاسم، رقم التليفون، الولاية والبلدية. فريقنا يتصل بيك باش يأكد معاك الطلبية قبل الإرسال، بكل بساطة." },
  { q: "واش نقدر نخلص عند الاستلام؟", a: "إيه، الدفع كامل عند الاستلام (COD). ما تخلص والو مسبقاً — غير كي توصلك السلعة لباب دارك." },
  { q: "شحال من ولاية توصلو؟", a: "نوصلو لـ 69 ولاية عبر الوطن. مصاريف التوصيل تتحسب حسب ولايتك وتبانلك في الفورمولار قبل ما تأكد الطلبية." },
  { q: "المحيط 19 سم — يواتي يدي؟", a: "المحيط الداخلي 19 سم يواتي أغلب المعاصم. وإذا كان واسع عليك، أي ساعة أو جواهرجي يقدر يقصرو في دقائق بلا ما يخسر جماليته." },
  { q: "واش تسبب حساسية للجلد؟", a: "لا، الخامة Hypoallergénique مضادة للحساسية ومناسبة حتى للبشرة الحساسة. تلبسو نهار كامل بلا قلق." },
];
---
<StoreLayout config={config} content={content} title={lp?.metaTitle || "عرض خاص"} marketing={true}>
<!-- رموز SVG مشتركة (أيقونات + تمساح لاكوست) -->
<svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="lp-croc" viewBox="0 0 120 44">
      <path fill="currentColor" d="M5 22C2 26 5 31 11 31C16 31 20 30 24 29L27 33L31 29L35 32L39 29L43 32L47 29C55 31 63 31 70 29L74 33L78 29C84 29 90 27 95 24L112 26L97 21L114 16L96 14C90 10 80 9 72 11C64 9 55 9 48 11L45 7L41 11L37 7L33 11L29 7L25 11C18 12 11 15 7 19C6 20 5 21 5 22Z"/>
      <path fill="#C0392B" d="M97 21L107 24L105 18Z"/>
      <circle cx="78" cy="13.5" r="1.8" fill="#F7F4EC"/>
    </symbol>
    <symbol id="lp-star" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.8l2.9 5.8 6.4.9-4.6 4.5 1.1 6.4-5.8-3-5.8 3 1.1-6.4L2.7 9.5l6.4-.9z"/></symbol>
    <symbol id="lp-spark" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2l2.3 7.7L22 12l-7.7 2.3L12 22l-2.3-7.7L2 12l7.7-2.3z"/></symbol>
    <symbol id="lp-check" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></g></symbol>
    <symbol id="lp-chev" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></g></symbol>
    <symbol id="lp-truck" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 16V6H4v10h1"/><path d="M14 9h4l3 3v4h-2"/><circle cx="7.5" cy="17.5" r="1.8"/><circle cx="16.5" cy="17.5" r="1.8"/><path d="M9.3 17.5H14"/></g></symbol>
    <symbol id="lp-cash" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M6 12h.01M18 12h.01"/></g></symbol>
    <symbol id="lp-shield" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6l7-3z"/><path d="M9 11.6l2.1 2.1 4-4.2"/></g></symbol>
    <symbol id="lp-ruler" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="9" width="18" height="6" rx="1.5"/><path d="M7 9v2.5M11 9v2.5M15 9v2.5M19 9v2.5"/></g></symbol>
    <symbol id="lp-hlink" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 5v14M17 5v14M7 12h10"/></g></symbol>
    <symbol id="lp-pique" viewBox="0 0 24 24"><g fill="currentColor"><circle cx="6" cy="6" r="1.5"/><circle cx="12" cy="6" r="1.5"/><circle cx="18" cy="6" r="1.5"/><circle cx="6" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="18" cy="12" r="1.5"/><circle cx="6" cy="18" r="1.5"/><circle cx="12" cy="18" r="1.5"/><circle cx="18" cy="18" r="1.5"/></g></symbol>
    <symbol id="lp-clasp" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="9" width="7" height="6" rx="1"/><rect x="13.5" y="9" width="7" height="6" rx="1"/><path d="M10.5 12h3M12 6.5V9M12 15v2.5"/></g></symbol>
    <symbol id="lp-lock" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/><circle cx="12" cy="15.5" r="1.2" fill="currentColor" stroke="none"/></g></symbol>
    <symbol id="lp-phone" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.7a2 2 0 01-.4 2.1L8 9.8a16 16 0 006 6l1.3-1.3a2 2 0 012.1-.4c.9.3 1.8.5 2.7.6a2 2 0 011.9 2.2z"/></g></symbol>
    <symbol id="lp-box" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5M12 13v8"/></g></symbol>
    <symbol id="lp-flame" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3q4 4 4 8.5a4 4 0 11-8 0Q8 7 12 3z"/><path d="M12 13.5q1.6 1.4 1.6 2.9a1.6 1.6 0 11-3.2 0q0-1.5 1.6-2.9z"/></g></symbol>
    <symbol id="lp-arrow-d" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></g></symbol>
  </defs>
</svg>

{product && (
<div id="lp-root" class="lp-font-body bg-[#F7F4EC] min-h-screen text-[#1B2B22] overflow-x-clip" dir={isRTL ? "rtl" : "ltr"}>
<!-- جسر البيانات اللازم للسكريبتات والولايات -->
<div
id="page-data"
class="sr-only"
data-variants={JSON.stringify(product.variants ?? [])}
data-base-price={basePrice}
data-compare-price={comparePrice ?? ""}
data-cur={cur}
data-is-rtl={isRTL ? "1" : "0"}
data-shipping-label={content.shippingLabel}
data-shipping-calc={content.shippingCalculated}
data-shipping-free={content.shippingFree}
data-total-label={content.totalLabel}
data-commune-placeholder={content.formCommunePlaceholder}
data-commune-loading={content.formCommuneLoading}
data-commune-disabled={content.formCommuneDisabled}
data-offers={JSON.stringify(product.offers ?? [])}
data-track-inventory={product.trackInventory ? "1" : "0"}
data-out-of-stock-label={content.outOfStock}
data-qty-max-stock={content.qtyMaxStock}
data-inventory={String(product.inventory ?? 0)}
data-pixel-id={lp.tracking?.pixelId ?? config.pixelId ?? ""}
data-phone-invalid={content.formPhoneInvalid}
data-product-id={product.id}
data-product-name={product.name}
/>
<ShippingIsland server:defer />

<!-- ═══════════ الهيدر الثابت + شريط العروض ═══════════ -->
<header id="lp-head" class="fixed top-0 inset-x-0 z-50">
  <div class="lp-ticker bg-[#0B241A] text-[#E9D9A0] text-[11px] font-medium h-8 flex items-center border-b border-[#D4AF37]/10">
    <div class="lp-ticker-track" dir="ltr">
      {[0, 1].map((copy) => (
        <div class="flex items-center gap-10 pe-10" aria-hidden={copy === 1 ? "true" : undefined}>
          {tickerItems.map((t) => (
            <span class="flex items-center gap-2 whitespace-nowrap">
              <svg class="w-3 h-3 text-[#D4AF37] shrink-0"><use href="#lp-spark"/></svg>{t}
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
  <div class="lp-head-bar bg-[#123B2A]/85 backdrop-blur-md border-b border-[#D4AF37]/15 transition-all duration-300">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
      <a href="#lp-hero" class="flex items-center gap-3 group" aria-label="Lacoste Metropole — البداية">
        <svg class="w-10 h-[15px] text-[#2FBF7F] group-hover:text-[#3AD98F] transition-colors"><use href="#lp-croc"/></svg>
        <span class="leading-none">
          <span class="lp-font-latin block text-[#F7F4EC] text-lg tracking-[0.28em]">LACOSTE</span>
          <span class="lp-font-latin block text-[#D4AF37] text-[9px] tracking-[0.42em] mt-1">METROPOLE</span>
        </span>
      </a>
      <nav class="hidden lg:flex items-center gap-7 text-sm text-[#C9D6CC]" aria-label="أقسام الصفحة">
        <a data-spy href="#features" class="hover:text-[#F1E3B2] transition-colors">المميزات</a>
        <a data-spy href="#specs" class="hover:text-[#F1E3B2] transition-colors">المواصفات</a>
        <a data-spy href="#offer" class="hover:text-[#F1E3B2] transition-colors">العرض</a>
        <a data-spy href="#reviews" class="hover:text-[#F1E3B2] transition-colors">الآراء</a>
        <a data-spy href="#faq" class="hover:text-[#F1E3B2] transition-colors">الأسئلة</a>
      </nav>
      <a data-cta href="#order-section-wrapper" class="lp-btn-gold inline-flex items-center gap-2 bg-gradient-to-l from-[#E8CE7A] via-[#D4AF37] to-[#B8912F] text-[#2A1F06] text-sm font-extrabold px-4 sm:px-5 py-2.5 rounded-full shadow-[0_8px_24px_-8px_rgba(212,175,55,.6)] hover:brightness-105 active:scale-[.97] transition">
        <svg class="w-4 h-4"><use href="#lp-box"/></svg>
        اطلب الآن
      </a>
    </div>
  </div>
</header>

<main>
  <!-- ═══════════ الهيرو ═══════════ -->
  <section id="lp-hero" class="lp-hero-bg relative overflow-hidden text-[#F7F4EC]">
    <div class="lp-pique absolute inset-0 opacity-60 pointer-events-none" aria-hidden="true"></div>
    <div class="lp-grain" aria-hidden="true"></div>
    <div class="lp-drift absolute -top-32 -end-32 w-96 h-96 rounded-full bg-[#D4AF37]/15 blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="lp-drift2 absolute -bottom-40 -start-32 w-[28rem] h-[28rem] rounded-full bg-[#17A566]/15 blur-3xl pointer-events-none" aria-hidden="true"></div>
    <span class="lp-font-latin absolute -bottom-4 inset-x-0 text-center text-[17vw] leading-none text-white/[.04] tracking-[.18em] select-none pointer-events-none" aria-hidden="true">METROPOLE</span>

    <div class="relative max-w-6xl mx-auto px-4 pt-[7.75rem] pb-14 lg:pb-20 grid gap-8 md:grid-cols-2 md:gap-12 md:items-center">
      <!-- العنوان -->
      <div class="md:col-start-1 text-center md:text-start">
        <p data-reveal="0" class="inline-flex items-center gap-2.5 bg-white/5 border border-[#D4AF37]/30 rounded-full px-4 py-1.5 text-[11px] text-[#F1E3B2]">
          <svg class="w-6 h-[9px] text-[#2FBF7F]"><use href="#lp-croc"/></svg>
          <span class="lp-font-latin tracking-[0.3em]">BRACELET METROPOLE</span>
        </p>
        <h1 data-reveal="80" class="lp-font-head font-black text-[2.55rem] leading-[1.15] sm:text-5xl lg:text-[3.5rem] mt-5">
          أناقة تكمل
          <span class="bg-gradient-to-l from-[#F1E3B2] via-[#D4AF37] to-[#B08A2E] bg-clip-text text-transparent"> إطلالتك</span>
        </h1>
        <p data-reveal="160" class="text-[#C9D6CC] text-base sm:text-lg leading-relaxed mt-4 max-w-xl mx-auto md:mx-0">
          سوار <bdi>Metropole</bdi> من لاكوست: مايين <bdi>H</bdi> الأيقونية ونقش <bdi>Petit Piqué</bdi> الشهير، بخامة مضادة للحساسية وقفل ديبليان يندمج مع التصميم. مع المونتر ولا وحدو… ديما يبان الفرق.
        </p>
        <div data-reveal="220" class="flex items-center justify-center md:justify-start gap-2.5 mt-4">
          <span class="flex text-[#D4AF37]" aria-hidden="true">
            {[0,1,2,3,4].map(() => (<svg class="w-4 h-4"><use href="#lp-star"/></svg>))}
          </span>
          <span class="text-sm text-[#C9D6CC]"><bdi>{ratingVal}/5</bdi> · +{ratingCount} زبون راضي عبر الولايات</span>
        </div>
      </div>

      <!-- المعرض -->
      <div class="md:col-start-2 md:row-start-1 md:row-span-2 self-center" data-reveal="120">
        <div id="lp-gallery" tabindex="0" role="group" aria-roledescription="معرض صور" aria-label="صور سوار Bracelet Metropole"
          class="relative aspect-square max-w-md mx-auto rounded-[2rem] overflow-hidden bg-[#0E3325] ring-1 ring-[#D4AF37]/25 shadow-[0_40px_80px_-30px_rgba(4,17,11,.8)] outline-none select-none" style="touch-action:pan-y">
          {hasGallery ? (
            gallery.map((src, i) => (
              <img src={src} alt={`Bracelet Metropole — صورة ${i + 1}`} draggable="false" decoding="async"
                loading={i === 0 ? "eager" : "lazy"}
                class="lp-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-700"
                style={i === 0 ? "opacity:1" : "opacity:0"} />
         ))
            <svg viewBox="0 0 800 800" class="absolute inset-0 w-full h-full" preserveAspectRatio="xMidYMid slice" role="img" aria-label="رسم توضيحي لسوار Metropole بمايين H ونقش Petit Piqué">
              <defs>
                <radialGradient id="lp-bg" cx="32%" cy="22%" r="90%">
                  <stop offset="0%" stop-color="#1E5C40"/><stop offset="55%" stop-color="#123B2A"/><stop offset="100%" stop-color="#0B241A"/>
                </radialGradient>
                <linearGradient id="lp-steel" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#F4F7F9"/><stop offset="35%" stop-color="#C3CCD4"/><stop offset="55%" stop-color="#97A3AD"/><stop offset="80%" stop-color="#D9E0E6"/><stop offset="100%" stop-color="#F2F5F7"/>
                </linearGradient>
                <linearGradient id="lp-plate" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#E7ECF0"/><stop offset="45%" stop-color="#B7C0C8"/><stop offset="70%" stop-color="#8C98A2"/><stop offset="100%" stop-color="#C6CED5"/>
                </linearGradient>
                <linearGradient id="lp-gold" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#F6E7B5"/><stop offset="45%" stop-color="#D9B94E"/><stop offset="75%" stop-color="#B08A2E"/><stop offset="100%" stop-color="#E8CE7A"/>
                </linearGradient>
