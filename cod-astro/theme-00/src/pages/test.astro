                  <rect x="21" y="9" width="40" height="92" rx="7" fill="none" stroke="#F3F6F8" stroke-width="0.9" opacity="0.55"/>
                  <rect x="0" y="0" width="16" height="110" rx="7.5" fill="url(#lp-steel)" stroke="#6E7A84" stroke-width="0.8"/>
                  <rect x="66" y="0" width="16" height="110" rx="7.5" fill="url(#lp-steel)" stroke="#6E7A84" stroke-width="0.8"/>
                  <rect x="2.5" y="4" width="4" height="102" rx="2" fill="#FFFFFF" opacity="0.5"/>
                  <rect x="68.5" y="4" width="4" height="102" rx="2" fill="#FFFFFF" opacity="0.5"/>
                </g>
              </defs>
              <rect width="800" height="800" fill="url(#lp-bg)"/>
              <rect width="800" height="800" fill="url(#lp-dots)" opacity="0.1"/>
