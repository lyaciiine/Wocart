                <svg class="w-5 h-5 lp-ico-next"><use href="#lp-chev"/></svg>
              </button>
              <div class="absolute bottom-3 inset-x-0 z-10 flex justify-center gap-1.5">
                {gallery.map((_s, i) => (
                  <button type="button" aria-label={`الصورة ${i + 1}`} aria-current={i === 0 ? "true" : "false"}
                    class={`lp-dot h-2 rounded-full transition-all duration-300 ${i === 0 ? "w-6 bg-[#D4AF37]" : "w-2 bg-white/40"}`}></button>
                ))}
