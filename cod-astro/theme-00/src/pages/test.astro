              <svg class="w-5 h-5"><use href="#lp-arrow-d"/></svg>
            </a>
            <a href="#features" class="inline-flex items-center justify-center gap-2 border border-[#D4AF37]/40 text-[#F1E3B2] font-bold text-sm px-6 py-3 rounded-2xl hover:bg-white/5 active:scale-[.98] transition">
              اكتشف التفاصيل
            </a>
          </div>
        </div>
        <div data-reveal="320" class="flex flex-wrap justify-center md:justify-start gap-2 mt-4 max-w-md mx-auto md:mx-0">
          {["الدفع عند الاستلام", "توصيل 69 ولاية", "19 سم قابل للتقصير"].map((c) => (
