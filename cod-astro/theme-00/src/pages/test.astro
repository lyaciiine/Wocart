              <path d="M 90 74 A 118 118 0 0 1 230 74" fill="none" stroke="#B08A2E" stroke-width="2.5" marker-end="url(#lp-arr)"/>
              <text x="160" y="152" text-anchor="middle" font-family="Alexandria, Tajawal, sans-serif" font-weight="800" font-size="56" fill="#123B2A">19</text>
              <text x="160" y="184" text-anchor="middle" font-family="Tajawal, sans-serif" font-weight="700" font-size="20" fill="#B08A2E">سم</text>
              <text x="160" y="212" text-anchor="middle" font-family="Tajawal, sans-serif" font-size="12.5" fill="#6B7780">المحيط الداخلي</text>
              <g>
                <rect x="104" y="238" width="22" height="12" rx="3" fill="#C9D2D8"/><rect x="130" y="238" width="22" height="12" rx="3" fill="#D4AF37"/><rect x="156" y="238" width="22" height="12" rx="3" fill="#C9D2D8"/><rect x="182" y="238" width="22" height="12" rx="3" fill="#D4AF37"/><rect x="208" y="238" width="22" height="12" rx="3" fill="#C9D2D8"/>
              </g>
