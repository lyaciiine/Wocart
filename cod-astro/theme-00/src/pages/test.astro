            <a data-cta href="#order-section-wrapper" class="lp-btn-gold inline-flex items-center gap-2 mt-5 bg-gradient-to-l from-[#E8CE7A] via-[#D4AF37] to-[#B8912F] text-[#2A1F06] text-sm font-extrabold px-5 py-3 rounded-xl shadow-[0_10px_26px_-10px_rgba(212,175,55,.6)] hover:brightness-105 active:scale-[.97] transition">
