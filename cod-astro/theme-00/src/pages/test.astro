                {[
                  "خلص كامل عند الاستلام — ما تدفع والو قبل",
                  "توصيل حتى لباب الدار في 69 ولاية",
                  "فريقنا يتصل بيك يأكد الطلبية قبل الإرسال",
                ].map((b) => (
                  <li class="flex items-start gap-2.5 text-sm text-[#C9D6CC]">
                    <span class="w-5 h-5 rounded-full bg-[#17A566]/20 text-[#3AD98F] grid place-items-center shrink-0 mt-0.5">
                      <svg class="w-3 h-3"><use href="#lp-check"/></svg>
                    </span>{b}
                  </li>
                ))}
              </ul>
            </div>
