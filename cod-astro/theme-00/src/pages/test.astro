      </div>
    </div>

    <a href="#features" aria-label="انزل للمميزات" class="lp-bounce relative z-10 mx-auto mb-6 w-10 h-10 rounded-full border border-[#D4AF37]/30 text-[#D4AF37] grid place-items-center hover:bg-white/5 transition">
      <svg class="w-5 h-5"><use href="#lp-arrow-d"/></svg>
