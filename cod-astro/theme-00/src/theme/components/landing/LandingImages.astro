
---
// The landing page's own images, stacked in their saved order with the
 // page's gap: all, or a range. Edge-to-edge on mobile and constrained
 // to 720px on wider screens. Each image reserves its space before it arrives.

import type { InferProps } from "@wocart/theme";
import type { LandingPage } from "@wocart/storefront";
import Section from "@/theme/components/ui/Section.astro";
import type { landingImages } from "@/theme/catalog/landing/landing.def";

type Props = Pick<
  InferProps<typeof landingImages>,
  "first" | "count" | "scheme" | "style"
> & {
  landing: LandingPage | null;
};

const {
  landing,
  first = 1,
  count = 0,
  scheme,
  style
} = Astro.props;

const start = Math.max(1, Math.floor(first)) - 1;

const images = landing
  ? [...landing.images]
      .sort((a, b) => a.position - b.position)
      .slice(start, count > 0 ? start + count : undefined)
  : [];

const opensPage = start === 0;
---

{landing && images.length > 0 && (
  <Section scheme={scheme} style={style} bleed>
    <div
      class="landing-stack"
      style={`--landing-gap: ${landing.imageGap}px`}
    >
      {images.map((image, index) => (
        <img
          src={image.url}
          alt={image.altText ?? landing.name}
          width={image.width ?? undefined}
          height={image.height ?? undefined}
          loading={opensPage && index < 2 ? "eager" : "lazy"}
          fetchpriority={opensPage && index === 0 ? "high" : undefined}
          decoding="async"
        />
      ))}
    </div>
  </Section>
)}

<style>
  .landing-stack {
    display: grid;
    gap: var(--landing-gap);
    width: 100%;
  }

  .landing-stack img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    background: var(--clr-surface);
  }

  @media (min-width: 768px) {
    .landing-stack {
      max-width: 720px;
      margin-inline: auto;
    }
  }
</style>
